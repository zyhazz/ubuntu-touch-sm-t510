#!/home/diego/dev/sm_t510_ubuntu_touch/.venv/bin/python3
"""Run a command on the tablet over SSH as root (key auth): ush 'cmd' [user]."""
import os, sys, paramiko
host, user = os.environ.get("T510_HOST", "172.16.3.105"), (sys.argv[2] if len(sys.argv) > 2 else "root")
key = os.path.join(os.path.dirname(__file__), "..", "keys", "t510_ed25519")
c = paramiko.SSHClient()
c.set_missing_host_key_policy(paramiko.AutoAddPolicy())
c.connect(host, username=user, key_filename=key, timeout=15, allow_agent=False, look_for_keys=False)
_, out, err = c.exec_command(sys.argv[1], timeout=180)
sys.stdout.write(out.read().decode(errors="replace"))
e = err.read().decode(errors="replace")
if e: sys.stderr.write(e)
sys.exit(out.channel.recv_exit_status())
