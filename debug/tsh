#!/usr/bin/env python3
"""Run a command on the Halium initramfs telnet shell: tsh 'cmd' [host]."""
import os, re, socket, sys, time
host = sys.argv[2] if len(sys.argv) > 2 else "192.168.2.15"
timeout = float(os.environ.get("TSH_TIMEOUT", "60"))
s = socket.create_connection((host, 23), timeout=10)

def read(until=None, t=1.0):
    buf, end = b"", time.time() + t
    while time.time() < end:
        s.settimeout(0.3)
        try:
            d = s.recv(65536)
        except socket.timeout:
            continue
        if not d:
            break
        buf += d
        if until and until in buf:
            break
    return buf

