[Unit]
Description=SM-T510: prepare Android container overrides
After=mount-android-partitions.service
Before=lxc-android-config.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/t510-container-prepare.sh

[Install]
WantedBy=lxc-android-config.service
