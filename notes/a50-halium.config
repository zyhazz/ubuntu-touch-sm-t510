# The minimal fragment the UBports standalone-kernel guide asks for.
# Every option here is already contained in halium_a50_defconfig; this file
# exists to follow the guide convention and as a guard if the defconfig is
# ever regenerated without one of these.
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
