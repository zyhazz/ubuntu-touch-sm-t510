From 0294cd79deafe2ce845fe733cc2725b4da356641 Mon Sep 17 00:00:00 2001
From: Diego Carvalho <737003+zyhazz@users.noreply.github.com>
Date: Wed, 30 Sep 2026 15:49:30 -0300
Subject: [PATCH 10/11] halium.config: build the audio DSP and amp firmware
 into the kernel

samsung-abox requests calliope_sram.bin at ~1.4s, before any rootfs, so
the DSP stayed disabled ('abox has been disabled') and every HAL write
failed with EBUSY. Same fix as the A50 port (CONFIG_EXTRA_FIRMWARE).
---
 arch/arm64/configs/halium.config | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/configs/halium.config b/arch/arm64/configs/halium.config
index 7001525e2..ddac2dbe6 100644
--- a/arch/arm64/configs/halium.config
+++ b/arch/arm64/configs/halium.config
@@ -74,3 +74,9 @@ CONFIG_CMDLINE_EXTEND=y
 
 # Stable uname -r for module paths
 # CONFIG_LOCALVERSION_AUTO is not set
+
+# --- audio DSP/amp firmware needed before the rootfs exists ---
+# ABOX asks for calliope_* at ~1.4s; without it "abox has been disabled".
+# scripts/build-kernel.sh copies the blobs from the stock vendor image.
+CONFIG_EXTRA_FIRMWARE="calliope_sram.bin calliope_dram.bin Tfa9896.cnt"
+CONFIG_EXTRA_FIRMWARE_DIR="/work/out/extra-firmware"
-- 
2.43.0

