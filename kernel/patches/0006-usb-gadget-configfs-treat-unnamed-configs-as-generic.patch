From 1e5cf276d18f8011eca025fd41fda3e65b6fd12f Mon Sep 17 00:00:00 2001
From: Diego Carvalho <737003+zyhazz@users.noreply.github.com>
Date: Wed, 30 Sep 2026 10:50:51 -0300
Subject: [PATCH 06/11] usb: gadget: configfs: treat unnamed configs as generic
 (GSI) users

Follow-up: with a NULL configuration the config was treated as Samsung's
framework mode, so linked functions were parked on linked_func and
binding the UDC failed with 'Config c/1 of g1 needs at least one
function' (-EINVAL). Only 'Conf 1' means Samsung framework.
---
 drivers/usb/gadget/configfs.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/gadget/configfs.c b/drivers/usb/gadget/configfs.c
index 117b22ef6..cca961baf 100644
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -575,10 +575,13 @@ static bool is_symboliclink_change_mode (struct config_usb_cfg *cfg)
 	if (!list_empty(&cfg->string_list)) {
 		list_for_each_entry(cn, &cfg->string_list, list) {
 			/*
-			 * configuration is NULL until userspace writes it;
-			 * usb-moded links functions before doing so.
+			 * Only Samsung's Android framework names its config
+			 * "Conf 1". Anything else, including a configuration
+			 * not written yet (NULL: usb-moded links functions
+			 * before naming the config), is a generic configfs
+			 * user and must get functions bound directly.
 			 */
-			if (cn->configuration &&
+			if (!cn->configuration ||
 			    strcmp(cn->configuration, "Conf 1") != 0)
 				return true;
 		}
