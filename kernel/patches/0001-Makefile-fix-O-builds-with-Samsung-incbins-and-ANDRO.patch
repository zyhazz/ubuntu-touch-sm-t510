From a9936dc63ff606a52408ae7fa7004b2f1b86d61b Mon Sep 17 00:00:00 2001
From: Diego Carvalho <737003+zyhazz@users.noreply.github.com>
Date: Wed, 30 Sep 2026 07:54:58 -0300
Subject: [PATCH 01/11] Makefile: fix O= builds with Samsung incbins and
 ANDROID_VERSION

- pass -I$(srctree) to gas so relative .incbin paths (uh.elf, defex certs)
  resolve when building out of tree
- define ANDROID_VERSION for C when set in the environment; Samsung
  headers test it in #if and tfa9896 builds with -Werror -Wundef
---
 Makefile | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Makefile b/Makefile
index 2a03be868..f9eb4230d 100644
--- a/Makefile
+++ b/Makefile
@@ -394,6 +394,12 @@ KBUILD_CFLAGS   := -Wall -Wundef -Wstrict-prototypes -Wno-trigraphs \
 KBUILD_AFLAGS_KERNEL :=
 KBUILD_CFLAGS_KERNEL :=
 KBUILD_AFLAGS   := -D__ASSEMBLY__ $(call cc-option,-fno-PIE)
+# Samsung .incbin directives use srctree-relative paths; let gas find them in O= builds
+KBUILD_AFLAGS   += -Wa,-I$(srctree)
+# Samsung headers test ANDROID_VERSION in #if; drivers built with -Werror -Wundef need it
+ifneq ($(ANDROID_VERSION),)
+KBUILD_CFLAGS   += -DANDROID_VERSION=$(ANDROID_VERSION)
+endif
 KBUILD_AFLAGS_MODULE  := -DMODULE
 KBUILD_CFLAGS_MODULE  := -DMODULE
 KBUILD_LDFLAGS_MODULE := -T $(srctree)/scripts/module-common.lds
